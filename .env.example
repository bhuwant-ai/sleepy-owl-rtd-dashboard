# ============================================================================
# Environment variables for the Sleepy Owl RTD Dashboard
# Copy this file to ".env.local" and fill in the values. Never commit .env.local.
# ============================================================================

# --- Supabase (server-side only; never exposed to the browser) --------------
# Find these in your Supabase project: Settings (gear) -> API
#   SUPABASE_URL               = "Project URL"
#   SUPABASE_SERVICE_ROLE_KEY  = "service_role" secret key (NOT the anon key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional overrides ------------------------------------------------------
# Which demand-plan tab to read (defaults to the current one in code).
# DEMAND_TAB=Oct'26 RTD DP

# Force a specific "today" for testing (YYYY-MM-DD).
# DASHBOARD_TODAY=2026-09-10
